  {
    "id": "story_03_offene_rechnungen", "title": "Offene Rechnungen",
    "giver": { "type": "npc", "id": "lou" }, "minLevel": 1, "coop": { "min": 1, "max": 1 }, "repeatable": false, "intro": [],
    "stages": [
      { "id": "ramon", "description": "Schuldner 1: Ramón im Domino-Park von Little Havana Heights. Einschüchtern oder verhandeln?",
        "onStart": [{ "do": "spawnNpc", "tag": "ramon", "at": "debtor1", "hp": 200 }],
        "objectives": [{ "type": "choice", "at": "debtor1", "id": "debt_ramon" }] },
      { "id": "chad", "description": "Schuldner 2: Chad, Start-up-Gründer in Downtown. Er „disruptet“ gerade.",
        "onStart": [{ "do": "spawnNpc", "tag": "chad", "at": "debtor2", "hp": 200 }],
        "objectives": [{ "type": "choice", "at": "debtor2", "id": "debt_chad" }] },
      { "id": "kimberly", "description": "Schuldnerin 3: Kimberly, Influencerin am Ocean Strip.",
        "onStart": [{ "do": "spawnNpc", "tag": "kimberly", "at": "debtor3", "hp": 200 }],
        "objectives": [{ "type": "choice", "at": "debtor3", "id": "debt_kimberly" }] },
