        "objectives": [{ "type": "deliverVehicle", "tag": "van", "at": "trailerpark", "radius": 20, "minHealth": 0.25 }] }
    ],
    "rewards": { "money": 2200, "xp": 500 }
  },
  {
    "id": "story_10b_pilot", "title": "Eine Crew: Der Pilot",
    "giver": { "type": "npc", "id": "pilot" }, "minLevel": 1, "coop": { "min": 1, "max": 2 }, "repeatable": false, "intro": [],
    "stages": [
      { "id": "go", "description": "Fahr zum Leuchtturm in Sunset Village – dort feiern die Diebe mit Huxleys Glücks-Flamingo.",
        "objectives": [{ "type": "goTo", "at": "lighthouse", "radius": 22 }] },
      { "id": "fight", "description": "Hol dir den Plastik-Flamingo zurück.",
        "onStart": [{ "do": "spawnEnemies", "tag": "thieves", "gang": "marlin", "count": 4, "at": "lighthouse", "radius": 20 }, { "do": "spawnPickups", "tag": "flamingo", "at": "lighthouse", "count": 1, "radius": 6 }],
        "objectives": [{ "type": "defeat", "tag": "thieves" }, { "type": "collect", "tag": "flamingo" }] },
      { "id": "return", "description": "Bring den Flamingo zu Captain Huxley ans Flugfeld Sunset Key.",
        "objectives": [{ "type": "goTo", "at": "pilot", "radius": 10 }] }
    ],
    "rewards": { "money": 800, "xp": 300 }
  },
  {
    "id": "story_10c_lou", "title": "Eine Crew: Lou in Not",
    "giver": { "type": "phone", "id": "lou" }, "minLevel": 1, "coop": { "min": 1, "max": 4 }, "openJoin": true, "repeatable": false, "intro": [],
    "stages": [
      { "id": "go", "description": "Lou steckt auf dem Highway 9 fest. Schnell, bevor der Kaktus aufgibt!", "timeLimitSeconds": 240,
        "objectives": [{ "type": "goTo", "at": "louAmbush", "radius": 30 }] },
      { "id": "rescue", "description": "Rette Lou vor Gus' Männern!",
        "onStart": [{ "do": "spawnNpc", "tag": "lou", "at": "louAmbush", "hp": 500 }, { "do": "spawnEnemies", "tag": "goons", "gang": "neon", "count": 5, "at": "louAmbush", "radius": 24, "target": "lou" }],
        "objectives": [{ "type": "defeat", "tag": "goons" }, { "type": "protect", "tag": "lou", "seconds": 20 }] },
      { "id": "ranch", "description": "Bring Lou zur Ranch. Er fährt hinterher. Behauptet er.",
        "onStart": [{ "do": "dialog", "kind": "talk", "lines": [{ "who": "lou", "text": "Ich hab mich gar nicht gefürchtet. Ich hab nur … laut nachgedacht. Sehr laut. Mit Schreien." }] }],
        "objectives": [{ "type": "goTo", "at": "ranch", "radius": 16 }] }
    ],
    "rewards": { "money": 700, "xp": 300 }
  },
  {
    "id": "story_11_konvoi", "title": "Carla ruft an",
    "giver": { "type": "phone", "id": "carla" }, "minLevel": 1, "coop": { "min": 1, "max": 4 }, "openJoin": true, "repeatable": false, "intro": [],
    "stages": [
      { "id": "go", "description": "Fahr zur Route 41 bei Port Sabal. Der Geldtransport kommt gleich. (Spieler in der Nähe können mitmachen.)", "timeLimitSeconds": 360,
        "objectives": [{ "type": "goTo", "at": "convoyStart", "radius": 45 }] },
      { "id": "hit", "description": "Der Konvoi rollt! Zerstöre Gus' Geldtransporter – rammen, schießen, kreativ sein.", "timeLimitSeconds": 300,
        "onStart": [
          { "do": "spawnVehicle", "tag": "armored", "kind": "car", "model": "ck-truck", "color": 8, "at": "convoyStart", "pose": "road", "traffic": true },
          { "do": "spawnVehicle", "tag": "escort", "kind": "car", "model": "ck-suv", "color": 9, "at": "convoyStart", "pose": "road", "traffic": true, "ahead": 14 },
          { "do": "spawnVehicle", "tag": "escort", "kind": "car", "model": "ck-suv", "color": 9, "at": "convoyStart", "pose": "road", "traffic": true, "ahead": -14 },
          { "do": "setWanted", "level": 1 }
        ],
        "objectives": [{ "type": "destroy", "tag": "armored" }] },
      { "id": "loot", "description": "Schnapp dir die Geldsäcke aus dem Wrack. Gus' Wachleute steigen aus!",
        "onStart": [{ "do": "spawnPickups", "tag": "cash", "at": "tag:armored", "count": 4, "radius": 9 }, { "do": "spawnEnemies", "tag": "guards", "gang": "neon", "count": 4, "at": "tag:armored", "radius": 14 }],
        "objectives": [{ "type": "collect", "tag": "cash" }] },
      { "id": "escape", "description": "Abhauen! Und zwar mit Stil.",
        "onStart": [{ "do": "setWanted", "level": 2 }],
        "objectives": [{ "type": "loseWanted" }] }
    ],
    "rewards": { "money": 5000, "xp": 800 }
  },
  {
    "id": "story_12_ganz_oben", "title": "Ganz oben",
    "giver": { "type": "npc", "id": "grady" }, "minLevel": 1, "coop": { "min": 1, "max": 4 }, "openJoin": true, "repeatable": false, "intro": [],
    "stages": [
      { "id": "gate", "description": "Fahr zum Tor von Gus' Villa in Brickell Hills. Die Crew wartet. (Spieler in der Nähe können mitmachen.)",
        "objectives": [{ "type": "goTo", "at": "estateGate", "radius": 22 }] },
      { "id": "yard", "description": "Stürmt das Anwesen! Gus hat sein ganzes Neon Syndicate zusammengetrommelt.",
        "onStart": [
          { "do": "dialog", "kind": "radio", "lines": [
            { "who": "carla", "text": "Die Alarmanlage ist aus. Ich hab das Passwort geändert auf „GusIstPleite“." },
            { "who": "racer", "text": "Fluchtwagen steht. Motor läuft. Ich auch – vor Ungeduld." },
            { "who": "lou", "text": "Ich halte die Snacks! Das ist auch eine Aufgabe!" }
          ] },
          { "do": "spawnEnemies", "tag": "guards1", "gang": "neon", "count": 6, "at": "estate", "radius": 26 }
        ],
        "objectives": [{ "type": "defeat", "tag": "guards1" }] },
      { "id": "inner", "description": "Weiter rein! Gus versteckt sich hinter Wachen. Und hinter einem sehr großen Brunnen.",
        "onStart": [{ "do": "spawnEnemies", "tag": "guards2", "gang": "neon", "count": 6, "at": "estate", "radius": 18, "hp": 70 }],
        "objectives": [{ "type": "defeat", "tag": "guards2" }] },
      { "id": "gus", "description": "Showdown mit Gus!",
        "onStart": [
          { "do": "dialog", "kind": "talk", "lines": [
            { "who": "gus", "text": "Du? DU? Ich hab dir ein Apartment geschenkt! Mit Meerblick! Wenn man sich rauslehnt!" },
            { "who": "gus", "text": "Na schön. Dann eben altmodisch. Aber pass auf den Anzug auf, der ist aus Mailand!" }
          ] },
          { "do": "spawnEnemies", "tag": "gus", "gang": "neon", "count": 1, "at": "estate", "radius": 5, "hp": 650 },
          { "do": "spawnEnemies", "tag": "bodyguards", "gang": "neon", "count": 2, "at": "estate", "radius": 8, "hp": 120 }
        ],
        "objectives": [{ "type": "defeat", "tag": "gus" }] }
    ],
    "rewards": { "money": 10000, "xp": 1500 }
  }
]
