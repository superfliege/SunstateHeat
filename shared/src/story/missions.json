        "objectives": [{ "type": "deliverVehicle", "tag": "truck", "at": "caneDepot", "radius": 20, "minHealth": 0.5 }] }
    ],
    "rewards": { "money": 900, "xp": 400 }
  },
  {
    "id": "story_08_landebahn", "title": "Die Landebahn",
    "giver": { "type": "npc", "id": "grady" }, "minLevel": 1, "coop": { "min": 1, "max": 4 }, "openJoin": true, "repeatable": false, "intro": [],
