        "objectives": [{ "type": "goTo", "at": "airstrip", "radius": 35 }] },
      { "id": "bikers", "description": "Die Mangrove-Biker grillen auf der Rollbahn. Räum sie ab.",
        "onStart": [
          { "do": "dialog", "kind": "talk", "lines": [{ "who": "Biker", "text": "Ey, das ist unsere Grillbahn! Hier wird nur gelandet, wenn das Steak fertig ist!" }] },
          { "do": "spawnEnemies", "tag": "bikers", "gang": "mangrove", "count": 6, "at": "airstrip", "radius": 35 }
        ],
        "objectives": [{ "type": "defeat", "tag": "bikers" }] },
      { "id": "hog", "description": "Ihr Anführer „Big Hog“ kommt mit Verstärkung. Und Grillzange.",
        "onStart": [{ "do": "spawnEnemies", "tag": "hog", "gang": "mangrove", "count": 1, "at": "airstrip", "radius": 25, "hp": 320 }, { "do": "spawnEnemies", "tag": "bikers2", "gang": "mangrove", "count": 4, "at": "airstrip", "radius": 30 }],
        "objectives": [{ "type": "defeat", "tag": "hog" }, { "type": "defeat", "tag": "bikers2" }] }
    ],
    "rewards": { "money": 2000, "xp": 600, "reputation": { "gang": "dustline", "gain": 8, "rivalLoss": 8 } }
  },
  {
    "id": "story_09_lieferung", "title": "Erste eigene Lieferung",
    "giver": { "type": "npc", "id": "grady" }, "minLevel": 1, "coop": { "min": 1, "max": 3 }, "repeatable": false, "intro": [],
    "stages": [
      { "id": "van", "description": "Hol die Ware an der Landebahn ab.",
        "onStart": [{ "do": "spawnVehicle", "tag": "van", "kind": "car", "model": "ck-van", "at": "airstripRoad", "pose": "road" }],
        "objectives": [{ "type": "enterVehicle", "tag": "van" }] },
      { "id": "route", "description": "Bring die Ware zum Trailerpark Sunny Acres – über Route 41 oder die Pine Hollow Road. Gus' Leute sperren beide Straßen!",
        "onStart": [
          { "do": "spawnVehicle", "tag": "blockA", "kind": "car", "model": "ck-sedan", "at": "block1", "pose": "across" },
          { "do": "spawnVehicle", "tag": "blockB", "kind": "car", "model": "truck_red", "at": "block2", "pose": "across" },
          { "do": "spawnEnemies", "tag": "blockersA", "gang": "neon", "count": 3, "at": "block1", "radius": 10 },
          { "do": "spawnEnemies", "tag": "blockersB", "gang": "neon", "count": 2, "at": "block2", "radius": 10 }
