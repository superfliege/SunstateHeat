  {
    "id": "story_04_fluchtwagen", "title": "Fluchtwagen",
    "giver": { "type": "npc", "id": "carla" }, "minLevel": 1, "coop": { "min": 1, "max": 2 }, "repeatable": false, "intro": [],
    "stages": [
      { "id": "car", "description": "Steig in den beigen Fluchtwagen vor dem Velvet Tide.",
        "onStart": [{ "do": "spawnVehicle", "tag": "getaway", "kind": "car", "model": "ck-sedan", "color": 7, "at": "clubRoad", "pose": "road" }],
        "objectives": [{ "type": "enterVehicle", "tag": "getaway" }] },
      { "id": "bank", "description": "Fahr zur Bank in Downtown und halte davor.",
        "objectives": [{ "type": "goTo", "at": "bank", "radius": 12, "vehicleTag": "getaway" }] },
      { "id": "wait", "description": "Die Crew ist drin. Lass den Motor laufen und guck unschuldig.",
        "onStart": [{ "do": "dialog", "kind": "radio", "lines": [{ "who": "crew", "text": "Wir sind drin. Der Kassierer fragt, ob wir Kundenkarten haben. Wir sagen ja." }] }],
        "objectives": [{ "type": "survive", "seconds": 15 }] },
      { "id": "escape", "description": "Die Crew springt rein – Alarm! Häng die Polizei ab.",
        "onStart": [{ "do": "dialog", "kind": "radio", "lines": [{ "who": "crew", "text": "LOS LOS LOS! Und fahr nicht über Rot! … Okay, fahr über Rot!" }] }, { "do": "setWanted", "level": 3 }],
        "objectives": [{ "type": "loseWanted" }] },
      { "id": "drop", "description": "Bring Crew und Wagen zur Waschanlage „Bubble Bath“. Carla sagt, da sucht niemand. Nicht mal Lou.",
        "objectives": [{ "type": "deliverVehicle", "tag": "getaway", "at": "carWashRoad", "radius": 14 }] }
    ],
    "rewards": { "money": 1500, "xp": 350 }
  },
  {
    "id": "story_05_party", "title": "Party im Club",
    "giver": { "type": "npc", "id": "gus" }, "minLevel": 1, "coop": { "min": 1, "max": 4 }, "openJoin": true, "repeatable": false, "intro": [],
    "stages": [
      { "id": "meet", "description": "Geh zu Gus an den Eingang des Velvet Tide.",
        "objectives": [{ "type": "goTo", "at": "club", "radius": 8 }],
        "onComplete": [{ "do": "dialog", "kind": "talk", "lines": [
          { "who": "gus", "text": "Weißt du, was ich an dieser Stadt liebe? Jeder kann hier alles werden. Solange ich es erlaube." },
          { "who": "gus", "text": "Also, über deine Zukunft – Moment. Ist das … der Marlin Club? Auf MEINER Party? Ohne Gästeliste?!" }
        ] }] },
      { "id": "wave1", "description": "Der Marlin Club stürmt die Party! Erste Welle abwehren. (Spieler in der Nähe können mitmachen.)",
        "onStart": [{ "do": "spawnNpc", "tag": "gus", "at": "club", "hp": 900 }, { "do": "spawnEnemies", "tag": "w1", "gang": "marlin", "count": 4, "at": "club", "radius": 30 }],
        "objectives": [{ "type": "defeat", "tag": "w1" }] },
      { "id": "wave2", "description": "Zweite Welle! Sie haben Verstärkung von der Yacht geholt.",
        "onStart": [{ "do": "dialog", "kind": "talk", "lines": [{ "who": "gus", "text": "Nicht auf den Anzug! NICHT AUF DEN ANZUG!" }] }, { "do": "spawnEnemies", "tag": "w2", "gang": "marlin", "count": 6, "at": "club", "radius": 34 }],
        "objectives": [{ "type": "defeat", "tag": "w2" }] },
      { "id": "wave3", "description": "Letzte Welle – ihr „Kapitän“ ist persönlich da. Mit Kapitänsmütze.",
        "onStart": [{ "do": "spawnEnemies", "tag": "w3", "gang": "marlin", "count": 4, "at": "club", "radius": 30 }, { "do": "spawnEnemies", "tag": "captain", "gang": "marlin", "count": 1, "at": "club", "radius": 22, "hp": 260 }],
        "objectives": [{ "type": "defeat", "tag": "w3" }, { "type": "defeat", "tag": "captain" }] }
    ],
    "rewards": { "money": 2500, "xp": 500, "reputation": { "gang": "neon", "gain": 10, "rivalLoss": 8 } }
  },
  {
    "id": "story_06_deal", "title": "Der Deal",
    "giver": { "type": "npc", "id": "gus" }, "minLevel": 1, "coop": { "min": 1, "max": 2 }, "repeatable": false, "intro": [],
    "stages": [
      { "id": "car", "description": "Steig in Gus' Wagen mit der „Ware“ vor dem Velvet Tide.",
        "onStart": [{ "do": "spawnVehicle", "tag": "deal", "kind": "car", "model": "ck-suv-luxury", "color": 8, "at": "clubRoad", "pose": "road" }],
        "objectives": [{ "type": "enterVehicle", "tag": "deal" }] },
      { "id": "harbor", "description": "Fahr zum Kai auf der Hafeninsel. Pünktlich – Gus hasst Unpünktlichkeit fast so sehr wie Ehrgeiz.",
        "objectives": [{ "type": "goTo", "at": "harbor", "radius": 16, "vehicleTag": "deal" }] },
      { "id": "trap", "description": "FALLE! Polizei und Gus' Leute! Flieh aus der Stadt: Route 41 Richtung Westen.", "timeLimitSeconds": 240,
        "onStart": [
          { "do": "dialog", "kind": "call", "lines": [
            { "who": "gus", "text": "Nimm's nicht persönlich. Du bist einfach zu schnell aufgestiegen. Das macht mich nervös. Und wenn ich nervös bin, verschenke ich Leute an die Polizei." },
            { "who": "gus", "text": "Die Tasche ist übrigens leer. Wie dein Apartment. Ciao!" }
          ] },
          { "do": "setWanted", "level": 3 },
          { "do": "spawnEnemies", "tag": "traitors", "gang": "neon", "count": 5, "at": "harbor", "radius": 30 }
        ],
        "objectives": [{ "type": "goTo", "at": "cityExit", "radius": 28 }] },
      { "id": "lose", "description": "Häng die Verfolger ab. Das Outback wartet.",
        "objectives": [{ "type": "loseWanted" }] }
    ],
    "rewards": { "money": 0, "xp": 600 }
  },
  {
    "id": "story_07_staub", "title": "Staub",
    "giver": { "type": "npc", "id": "grady" }, "minLevel": 1, "coop": { "min": 1, "max": 2 }, "repeatable": false, "intro": [],
    "stages": [
