{
  "name": "sunstate-heat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sunstate Heat – Browser-Multiplayer Top-Down Open-World Prototyp (Meilenstein 1)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "textures": "tsx scripts/process-textures.ts",
    "audio": "tsx scripts/process-audio.ts",
    "test": "tsx scripts/validate-content.ts",
    "story-test": "tsx scripts/story-smoke.ts",
    "air-test": "tsx scripts/air-smoke.ts"
  },
  "dependencies": {
    "three": "0.170.0",
    "tsx": "4.19.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.170.0",
    "@types/ws": "8.5.13",
    "concurrently": "9.1.0",
    "jpeg-js": "^0.4.4",
    "lil-gui": "^0.21.0",
    "pngjs": "^7.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
